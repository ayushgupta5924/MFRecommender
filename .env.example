# ── Backend (set these on Render) ─────────────────────────────────────────────
# Postgres connection string, e.g. from Neon. Required in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string used to sign login codes and sessions.
AUTH_SECRET=
# Login code emails via Resend (https://resend.com); EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=MF Advisor <no-reply@yourdomain.in>
# Local development only: print login codes to the server log instead of emailing them,
# and allow the session cookie over plain http.
# EMAIL_DEV_MODE=1
# COOKIE_SECURE=0

# ── Frontend ──────────────────────────────────────────────────────────────────
# Nothing to set: vercel.json forwards /api to the backend.
